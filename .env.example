# ---------------------------------------------------------------- model (choose ONE block)
# Local Ollama only — no API key required.
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------- web search (optional: without a key DuckDuckGo is used)
SERPER_API_KEY=ttcUehGLKumArZAhKidTiAkK

# ---------------------------------------------------------------- database and n8n (defaults match docker-compose.yml)
# The agents use the READ-ONLY login. Migrations (scm) and the audit writer (scm_audit) default to the same host, port and database.
DATABASE_URL=postgresql+psycopg2://scm_ro:scm_ro@localhost:5432/erp
N8N_WEBHOOK_URL=http://localhost:5678/webhook/supply-chain-rfq
# N8N_WEBHOOK_TOKEN is generated into this file by scripts/setup_n8n.py when it is missing

KB_DIR=knowledge_base
SIMULATE_SEARCH_FAILURE=false
ENABLE_MEMORY=false

# ---------------------------------------------------------------- limits (defaults are fine)
MAX_RPM=20
LLM_TIMEOUT_S=120
LLM_RETRIES=1
AGENT_MAX_SECONDS=300
ERP_MAX_AGE_DAYS=7
ERP_STRICT_FRESHNESS=false

# ---------------------------------------------------------------- only if you changed ports, names or logins
# ERP_ADMIN_URL=postgresql://scm:scm@localhost:5432/erp        (used by the schema tests)
# MIGRATE_DATABASE_URL=   AUDIT_DATABASE_URL=                   (override the derived logins)
# N8N_CONTAINER=   N8N_BASE_URL=http://127.0.0.1:5678
